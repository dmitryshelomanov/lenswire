{
  "name": "lenswire",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "private": true,
  "description": "Native HTTP(S) inspector with MITM proxy for iOS and Android (Expo)",
  "author": {
    "name": "Dmitry Shelomanov",
    "email": "dmitryshelomanov@mail.ru",
    "url": "https://github.com/dmitryshelomanov"
  },
  "license": "MIT",
  "homepage": "https://github.com/dmitryshelomanov/lenswire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmitryshelomanov/lenswire.git"
  },
  "bugs": {
    "url": "https://github.com/dmitryshelomanov/lenswire/issues"
  },
  "keywords": [
    "http-inspector",
    "mitm",
    "proxy",
    "https",
    "vpn",
    "network-extension",
    "packet-tunnel",
    "expo",
    "react-native",
    "android",
    "ios",
    "debugging",
    "traffic"
  ],
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild:ios": "expo prebuild -p ios --clean && node scripts/link-hev-ios.js",
    "prebuild:android": "expo prebuild -p android --clean",
    "link:hev-ios": "node scripts/link-hev-ios.js",
    "version:bump": "node scripts/bump-version.mjs",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:preview:local": "npx eas-cli build --platform android --profile preview --local",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:android:local": "npx eas-cli build --platform android --profile production --local",
    "release:android:preview": "npm run version:bump && npm run build:android:preview:local && npm run release:android:github",
    "release:android:github": "bash scripts/release-android-github.sh",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "screenshots:store": "node scripts/generate-store-screenshots.mjs",
    "screenshots:play": "node scripts/generate-play-store-assets.mjs",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:start": "npm run start --prefix website",
    "website:deploy": "npm run deploy --prefix website",
    "sim:trust-ca": "bash scripts/sim-dev.sh trust-ca",
    "android:trust-ca": "bash scripts/android-trust-ca.sh",
    "check:ios-sync": "bash scripts/check-ios-sync.sh",
    "test": "npm run check:ios-sync && vitest run",
    "test:lint": "expo lint",
    "test:tsc": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@rn-primitives/portal": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "^57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lenswire-proxy": "file:./modules/lenswire-proxy",
    "lucide-react-native": "^1.27.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
